rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // غيّر البريد إلى بريدك (أو أضف عدة بريدات).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['you@gmail.com'];
    }
    match /videos/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /series/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }
    // قائمة البث المباشر (مستند واحد: live/current).
    match /live/{id}       { allow read: if true; allow write: if isAdmin(); }
    // بلاغات الزوار: أي شخص يُنشئ بلاغًا بحقول محدودة الحجم؛ القراءة والإدارة للمشرف فقط.
    match /reports/{id} {
      allow create: if request.resource.data.videoId is string && request.resource.data.videoId.size() <= 40
        && request.resource.data.videoTitle is string && request.resource.data.videoTitle.size() <= 200
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 80
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.size() <= 8;
      allow read, update, delete: if isAdmin();
    }
    // الصور المصغّرة الملتقطة من الفيديو (JPEG بصيغة base64). القراءة عامة لأن /api/thumb يخدمها للزوار.
    match /thumbs/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.b64 is string
        && request.resource.data.b64.size() < 300000;
      allow delete: if isAdmin();
    }
  }
}
