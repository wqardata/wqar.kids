rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // «المالك»: غيّر القائمة إلى بريداتك (يجب أن تطابق NEXT_PUBLIC_ADMIN_EMAILS / ADMIN_EMAILS).
    // المالك وحده يدير الأعضاء وصلاحياتهم.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['c.wqargroup@gmail.com'];
    }

    // «المشرف»: المالك، أو عضو دوره admin في users/{uid} وغير محظور (بريده موثّق).
    function isAdmin() {
      return isOwner()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) != true);
    }

    match /videos/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // المشرف يعدّل كل شيء؛ أي زائر يستطيع فقط: زيادة عدّاد المشاهدات بمقدار 1،
      // أو تغيير عدّاد المعجبين (زر المفضلة) بمقدار +1 أو −1 دون أن ينزل عن الصفر. لا شيء غير ذلك.
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views is int
            && request.resource.data.views == resource.data.get('views', 0) + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes is int
            && request.resource.data.likes >= 0
            && (request.resource.data.likes == resource.data.get('likes', 0) + 1
                || request.resource.data.likes == resource.data.get('likes', 0) - 1));
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /series/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }

    // إحصاء المشاهدات اليومي لمخطط الإقبال: مستند لكل يوم stats/d-YYYY-MM-DD. أي زائر يزيد عدّاد اليوم بمقدار 1 فقط
    // (أو ينشئ مستند اليوم بقيمة 1)؛ القراءة للمشرف فقط.
    match /stats/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['day', 'views'])
        && request.resource.data.day is string
        && id == ('d-' + request.resource.data.day)
        && request.resource.data.views == 1;
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views is int
            && request.resource.data.views == resource.data.views + 1);
    }

    // بلاغات الزوار: أي شخص (مسجَّل أو غير مسجَّل) يُنشئ بلاغًا بحقول محدودة الحجم؛ القراءة والإدارة للمشرف فقط.
    match /reports/{id} {
      allow create: if true
        && request.resource.data.videoId is string && request.resource.data.videoId.size() <= 40
        && request.resource.data.videoTitle is string && request.resource.data.videoTitle.size() <= 200
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 80
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.size() <= 8;
      allow read, update, delete: if isAdmin();
    }

    // إشعارات الإدارة. الفئات: all (كل الأعضاء المسجَّلين) • viewers (المشاهدون) • admins (المشرفون) • guests (غير المسجَّلين).
    // المشرف يكتب ويحذف ويقرأ الكل؛ الزائر غير المسجَّل يقرأ «guests» فقط؛ العضو المسجَّل يقرأ «all» و«viewers».
    // التطبيق يستعلم عن كل فئة على حدة (audience == X) فتُثبت القواعد صلاحية كل استعلام دون الاعتماد على «in».
    match /notifications/{id} {
      allow read: if isAdmin()
        || resource.data.audience == 'guests'
        || (request.auth != null && resource.data.audience in ['all', 'viewers']);
      allow create: if isAdmin()
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() <= 500
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.audience in ['all', 'viewers', 'admins', 'guests']
        && request.resource.data.size() <= 6;
      allow delete: if isAdmin();
    }

    // بصمات الفيديوهات لكشف المقدمة والإعلان تلقائيًا (للمشرف فقط؛ تُحسب مرة وتُحفظ).
    match /fingerprints/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.fp is string && request.resource.data.fp.size() < 100000;
    }

    // الصور المصغّرة الملتقطة من الفيديو (JPEG بصيغة base64). القراءة عامة لأن /api/thumb يخدمها للزوار.
    match /thumbs/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.b64 is string
        && request.resource.data.b64.size() < 300000;
      allow delete: if isAdmin();
    }

    // التسجيل الذاتي مُغلق: المالك يضيف أعضاء بإنشاء allowed/{البريد بأحرف صغيرة}. صاحب البريد يقرأ مستنده فقط (للتحقق عند الدخول).
    match /allowed/{email} {
      allow read: if request.auth != null && (isOwner() || request.auth.token.email.lower() == email);
      allow write: if isOwner();
    }

    // الأعضاء المسجَّلون: users/{uid}.
    //  - العضو يقرأ سجله وينشئه عند أول دخول (دور viewer فقط، وبشرط وجود بريده في allowed) ويعدّل اسمه وصورته فقط.
    //  - المالك وحده يقرأ كل الأعضاء ويغيّر الدور والحظر ويحذف السجل.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isOwner());

      allow create: if request.auth != null && request.auth.uid == uid
        // لا يُنشأ سجل عضو إلا للمالك أو لبريد أضافه المالك إلى allowed.
        && (isOwner() || exists(/databases/$(database)/documents/allowed/$(request.auth.token.email.lower())))
        && request.resource.data.role == 'viewer'
        && request.resource.data.banned == false
        && request.resource.data.keys().hasOnly(['email', 'name', 'avatar', 'role', 'banned', 'createdAt', 'lastLoginAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 20;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.banned == resource.data.banned
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'avatar', 'lastLoginAt'])
        && request.resource.data.name.size() <= 60
        && request.resource.data.avatar.size() <= 20;

      allow update, delete: if isOwner();
    }
  }
}
