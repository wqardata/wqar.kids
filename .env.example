# --- Firebase (Project settings → General → Your apps → Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- من يحق له إضافة فيديوهات (بريدات جوجل مفصولة بفاصلة) ---
# اتركه فارغًا ليسمح لأي مسجَّل بالدخول (غير مُوصى به؛ يجب أن تطابق firestore.rules).
NEXT_PUBLIC_ADMIN_EMAILS=you@gmail.com
ADMIN_EMAILS=you@gmail.com

# --- اختياري: مفتاح Google Drive API ---
# يُستعمل لجلب اسم الملف بدقة أكبر، ولقراءة الفيديو عند التقاط «لقطة عشوائية بعد الثانية 10».
# لجلب مدة الفيديو بدقة (فعّل Google Drive API في Google Cloud).
# «استيراد مجلد من درايف» يعمل الآن بدونه (يقرأ صفحة المجلد العامة بلا مدد)؛ ومعه تُجلب المدد أيضًا.
# بدونه يُجلب الاسم من صفحة الملف العامة، ويُقرأ الفيديو من رابط التنزيل العام (قد يتعثر مع الملفات الكبيرة جدًا).
DRIVE_API_KEY=

# --- اختياري: معرّف عميل جوجل (OAuth Web client ID) ---
# يُظهر عند التسجيل بالبريد اقتراح حساب جوجل الموجود في متصفح الزائر فيُملأ بريده تلقائيًا.
# من Firebase Console ← Authentication ← Sign-in method ← Google ← Web SDK configuration ← Web client ID.
# وفي Google Cloud ← APIs & Services ← Credentials ← هذا العميل ← Authorized JavaScript origins: أضف دومينك (و http://localhost:3000).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# صوت الأذكار: مسار احتياطي عبر فيرسل (يستهلك نقل بيانات). اتركه فارغًا ليعمل الصوت مباشرة من درايف فقط.
# NEXT_PUBLIC_ADHKAR_AUDIO_PROXY=1

# --- اختياري: مفتاح Drive API لتشغيل الفيديو مباشرة في المشغّل المخصّص ---
# بدونه يُستعمل رابط التنزيل العام (يكفي لأغلب الملفات). المفتاح ظاهر للمتصفح، فقيّده في Google Cloud
# بنطاق موقعك (HTTP referrers) وبواجهة Google Drive API فقط. لا يمرّ الفيديو على فيرسل في الحالتين.
# NEXT_PUBLIC_DRIVE_API_KEY=

# --- Neon (Postgres): سلسلة الاتصال من لوحة Neon (Connection string، يُفضَّل pooled). تُضبط في Vercel ← Environment Variables. ---
# أثناء الانتقال يبقى Firestore هو الافتراضي؛ هذا المتغير وحده لا يغيّر شيئًا في الموقع.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
